@using FleetManagementSystem_.Net.Areas.Identity.Models
@model IEnumerable<FMSRole>

@{
    ViewData["Title"] = "Roles";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Roles</h2>
    <a asp-area="Identity" asp-controller="Role" asp-action="Edit" class="btn btn-outline-primary">Create New</a>
</div>

<table class="table table-striped table-bordered">
    <thead class="table-light">
        <tr>
            <th scope="col">Name</th>
            <th scope="col">Description</th>
            <th scope="col">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var role in Model)
            {
                <tr>
                    <td>@role.Name</td>
                    <td>@role.Description</td>
                    <td>
                        <a asp-area="Identity" asp-controller="Role" asp-action="Edit" asp-route-id="@role.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        @{ var confirmModel = new FleetManagementSystem_.Net.Models.ConfirmPromptModel { Message = $"Delete role {role.Name}? This action cannot be undone.", Url = Url.Action("Delete","Role", new { area = "Identity", id = role.Id }), Method = "POST", ButtonText = "Delete" }; }
                        <partial name="_ConfirmPrompt" model="confirmModel" />
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="3" class="text-center text-muted">No roles found.</td>
            </tr>
        }
    </tbody>
</table>
