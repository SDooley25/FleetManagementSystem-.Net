@using FleetManagementSystem_.Net.Areas.Identity.Models
@model IEnumerable<FMSRole>

@{
    ViewData["Title"] = "Roles";
}

<h2>Roles</h2>

<p>
    <a asp-area="Identity" asp-controller="Role" asp-action="edit" class="btn btn-success">Create New Role</a>
</p>

<table class="table table-striped table-bordered">
    <thead class="table-light">
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var role in Model)
            {
                <tr>
                    <td>@role.Name</td>
                    <td>@role.Description</td>
                    <td>
                        <a asp-area="Identity" asp-controller="Role" asp-action="Edit" asp-route-id="@role.Id" class="btn btn-sm btn-primary">Edit</a>
                        <a asp-area="Identity" asp-controller="Role" asp-action="Delete" asp-route-id="@role.Id" class="btn btn-sm btn-danger ms-2">Delete</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="3" class="text-muted">No roles found.</td>
            </tr>
        }
    </tbody>
</table>
