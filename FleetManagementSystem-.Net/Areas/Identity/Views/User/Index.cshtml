@using FleetManagementSystem_.Net.Areas.Identity.Models
@model List<FMSUser.ListItem>

@{
    ViewData["Title"] = "Users";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">@ViewData["Title"]</h2>
    <a asp-area="Identity" asp-controller="User" asp-action="Edit" class="btn btn-primary">Create New</a>
</div>

<table class="table table-striped table-bordered">
    <thead class="table-light">
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Username</th>
            <th scope="col">Lockout End</th>
            <th scope="col">Access Failed Attempts</th>
            <th scope="col" style="width:150px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model == null || !Model.Any())
        {
            <tr>
                <td colspan="5" class="text-center text-muted">No users found.</td>
            </tr>
        }
        else
        {
            foreach (var u in Model)
            {
                <tr>
                    <td class="align-middle">@u.Id</td>
                    <td class="align-middle">@u.UserName</td>
                    <td class="align-middle">
                        @(u.LockoutEnd.HasValue? u.LockoutEnd.Value.ToString("u") : "—")
                    </td>
                    <td class="align-middle">@u.AccessFailedCount</td>
                    <td class="align-middle">
                        <a asp-area="Identity" asp-controller="User" asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary me-1">Edit</a>
                        <a asp-area="Identity" asp-controller="User" asp-action="Details" asp-route-id="@u.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>