@using FleetManagementSystem_.Net.Extensions
@using FleetManagementSystem_.Net.Models
@model List<Vehicle>
@{
    ViewData["Title"] = "Vehicles";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">@ViewData["Title"]</h2>
    <a asp-area="VehicleStorage" asp-controller="Vehicle" asp-action="Edit" class="btn btn-outline-primary">Create New</a>
</div>

<table class="table table-striped table-bordered">
    <thead class="table-light">
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Registration</th>
            <th scope="col">Make</th>
            <th scope="col">Model</th>
            <th scope="col">Fuel</th>
            <th scope="col">Engine</th>
            <th scope="col">Reg Date</th>
            <th scope="col">Last MOT</th>
            <th scope="col">Last MOT Mileage</th>
            <th scope="col" style="width:150px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model == null || !Model.Any())
        {
            <tr><td colspan="10" class="text-center text-muted">No vehicles found.</td></tr>
        }
        else
        {
            foreach (var v in Model)
            {
                <tr>
                    <td class="align-middle">@v.Id</td>
                    <td class="align-middle">@v.RegistrationNumber</td>
                    <td class="align-middle">@v.Make</td>
                    <td class="align-middle">@v.Model</td>
                    <td class="align-middle">@v.FuelType</td>
                    <td class="align-middle">@v.EngineSize</td>
                    <td class="align-middle">@v.DateOfRegistration.ToString("d")</td>
                    <td class="align-middle">@(v.LastMotDate.HasValue? v.LastMotDate.Value.ToString("d") : "—")</td>
                    <td class="align-middle">@(v.LastMotMileage.HasValue? v.LastMotMileage.ToString() : "—")</td>
                    <td class="align-middle">
                        <a asp-area="VehicleStorage" asp-controller="Vehicle" asp-action="Edit" asp-route-id="@v.Id" class="btn btn-sm btn-outline-primary me-1">Edit</a>
                        @if (User.IsInRoleLike("VehicleStorage.Admin"))
                        {
                            var confirmModel = new ConfirmPromptModel { Message = $"Delete vehicle {v.Make} {v.Model}? This action cannot be undone.", Url = Url.Action("Delete", "Vehicle", new { area = "VehicleStorage", id = v.Id }), Method = "POST", ButtonText = "Delete" };
                            <partial name="_ConfirmPrompt" model="confirmModel" />
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
