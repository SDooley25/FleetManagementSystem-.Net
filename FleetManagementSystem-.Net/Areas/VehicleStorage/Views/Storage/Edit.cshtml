@using FleetManagementSystem_.Net.Areas.VehicleStorage.ViewModels
@model VehicleStorageEditViewModel
@{
    ViewData["Title"] = Model.Id == Guid.Empty ? "Create Storage" : "Edit Storage";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Edit" method="post" class="needs-validation" novalidate>
    @Html.AntiForgeryToken()

    <div asp-validation-summary="All" class="text-danger"></div>

    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="VehicleId"></label>
        <select asp-for="VehicleId" class="form-select">
            <option value="">Select vehicle</option>
            @foreach (var v in Model.Vehicles)
            {
                <option value="@v.Id" selected="@(Model.VehicleId == v.Id ? "selected" : null)">@v.RegistrationNumber</option>
            }
        </select>
        <span asp-validation-for="VehicleId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="StorageSiteId"></label>
        <select asp-for="StorageSiteId" class="form-select">
            <option value="">Select site</option>
            @foreach (var s in Model.Sites)
            {
                <option value="@s.Id" selected="@(Model.StorageSiteId == s.Id ? "selected" : null)">@s.Name</option>
            }
        </select>
        <span asp-validation-for="StorageSiteId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="StorageType" class="form-label"></label>
        <select asp-for="StorageType" class="form-select">
            @foreach (var v in Enum.GetValues(typeof(FleetManagementSystem_.Net.Models.Enums.StorageType)))
            {
                <option value="@v" selected="@(Model.StorageType.ToString() == v.ToString() ? "selected" : null)">@v</option>
            }
        </select>
        <span asp-validation-for="StorageType" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="StartDate" class="form-label"></label>
        <input asp-for="StartDate" type="date" class="form-control" />
        <span asp-validation-for="StartDate" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="EndDate" class="form-label"></label>
        <input asp-for="EndDate" type="date" class="form-control" />
        <span asp-validation-for="EndDate" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Note" class="form-label"></label>
        <textarea asp-for="Note" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Note" class="text-danger"></span>
    </div>

    <div>
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
