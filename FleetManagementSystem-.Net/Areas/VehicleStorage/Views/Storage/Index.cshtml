@model List<FleetManagementSystem_.Net.Models.VehicleStorage>
@{
    ViewData["Title"] = "Vehicle Storage";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">@ViewData["Title"]</h2>
    <a class="btn btn-outline-primary" asp-action="Edit">Create New</a>
</div>

<table class="table table-striped table-bordered">
    <thead class="table-light">
        <tr>
            <th scope="col">Vehicle</th>
            <th scope="col">Site</th>
            <th scope="col">Storage Type</th>
            <th scope="col">Start Date</th>
            <th scope="col">End Date</th>
            <th scope="col" style="width:150px;">Actions</th>
        </tr>
    </thead>
    <tbody>
    @if (Model == null || !Model.Any())
    {
        <tr>
            <td colspan="6" class="text-center">No vehicle storage records found.</td>
        </tr>
    }
    else
    {
        foreach (var item in Model)
        {
            <tr>
                <td>@item.Vehicle.RegistrationNumber</td>
                <td>@item.StorageSite.Name</td>
                <td>@item.StorageType</td>
                <td>@item.StartDate.ToString("yyyy-MM-dd")</td>
                <td>@(item.EndDate?.ToString("yyyy-MM-dd") ?? "")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1">Edit</a>
                    @if (User.IsInRole("VehicleStorage.Admin"))
                    {
                        var confirmModel = new FleetManagementSystem_.Net.Models.ConfirmPromptModel {
                            Message = $"Are you sure you want to delete vehicle storage for {item.Vehicle.RegistrationNumber} at {item.StorageSite.Name}?",
                            Url = Url.Action("Delete", "Storage", new { area = "VehicleStorage", id = item.Id }),
                            Method = "POST",
                            ButtonText = "Delete"
                        };
                        <partial name="_ConfirmPrompt" model="confirmModel" />
                    }
                </td>
            </tr>
        }
    }
    </tbody>
</table>
