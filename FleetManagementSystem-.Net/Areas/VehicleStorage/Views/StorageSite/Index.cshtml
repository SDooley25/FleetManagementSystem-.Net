@using FleetManagementSystem_.Net.Extensions
@using FleetManagementSystem_.Net.Models
@model List<StorageSite>

@{
    ViewData["Title"] = "Storage Sites";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Storage Sites</h2>
    <a class="btn btn-outline-primary" asp-action="Edit">Create New</a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-striped table-bordered">
    <thead class="table-light">
        <tr>
            <th scope="col">Name</th>
            <th scope="col">Address</th>
            <th scope="col">Postcode</th>
            <th scope="col">Max Vehicle Capacity</th>
            <th scope="col">Has Repair Station</th>
            <th scope="col">In Use Date</th>
            <th scope="col">Out Use Date</th>
            <th scope="col" style="width:150px;">Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var site in Model)
    {
        // For address, only show first line (up to first newline) for compactness
        <tr>
            <td class="align-middle">@site.Name</td>
            <td class="align-middle">@( (site.Address ?? string.Empty).Split(new[]{'\r','\n'}, StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? string.Empty )</td>
            <td class="align-middle">@site.Postcode</td>
            <td class="align-middle">@site.MaxVehicleCapacity</td>
            <td class="align-middle">@(site.HasRepairStation ? "Yes" : "No")</td>
            <td class="align-middle">@(site.InUseDate?.ToString("yyyy-MM-dd") ?? "")</td>
            <td class="align-middle">@(site.OutUseDate?.ToString("yyyy-MM-dd") ?? "")</td>
                <td class="align-middle">
                <a class="btn btn-sm btn-outline-primary me-1" asp-action="Edit" asp-route-id="@site.Id">Edit</a>

                @if (User.IsInRoleLike("VehicleStorage.Admin"))
                {
                    var confirmModel = new ConfirmPromptModel {
                        Message = $"Delete storage site {site.Name}? This action cannot be undone.",
                        Url = Url.Action("Delete", "StorageSite", new { area = "VehicleStorage", id = site.Id }),
                        Method = "POST",
                        ButtonText = "Delete"
                    };
                    <partial name="_ConfirmPrompt" model="confirmModel" />
                }
            </td>
        </tr>
    }
    </tbody>
</table>
