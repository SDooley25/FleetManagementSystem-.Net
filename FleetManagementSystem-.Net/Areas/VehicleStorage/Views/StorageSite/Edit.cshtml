@using FleetManagementSystem_.Net.Models
@model StorageSite

@{
    ViewData["Title"] = "Edit Storage Site";
}

<h2>@(Model.Id == Guid.Empty ? "Create Storage Site" : "Edit Storage Site")</h2>

<form asp-action="Edit" method="post" class="needs-validation" novalidate>
    @Html.AntiForgeryToken()

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <!-- show id disabled, but include hidden input so it posts -->
    <div class="mb-3">
        <label class="form-label">Id</label>
        <input class="form-control" value="@Model.Id" disabled />
        <input type="hidden" name="Id" value="@Model.Id" />
    </div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Address" class="form-label"></label>
        <textarea asp-for="Address" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Postcode" class="form-label"></label>
        <input asp-for="Postcode" class="form-control" />
        <span asp-validation-for="Postcode" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="MaxVehicleCapacity" class="form-label"></label>
        <input asp-for="MaxVehicleCapacity" type="number" class="form-control" />
        <span asp-validation-for="MaxVehicleCapacity" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="HasRepairStation" class="form-check-input" />
        <label asp-for="HasRepairStation" class="form-check-label"></label>
    </div>

    <div class="mb-3">
        <label asp-for="InUseDate" class="form-label"></label>
        <input asp-for="InUseDate" class="form-control" type="date" />
        <span asp-validation-for="InUseDate" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="OutUseDate" class="form-label"></label>
        <input asp-for="OutUseDate" class="form-control" type="date" />
        <span asp-validation-for="OutUseDate" class="text-danger"></span>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
